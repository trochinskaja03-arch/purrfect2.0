# Скопіюйте значення у Vercel → Settings → Environment Variables.
# Цей файл — лише зразок, справжні ключі в репозиторій не кладіть.

# --- Адреса сайту (без слеша в кінці) ---
# З неї беремо домен для підпису платежу та адреси, на які WayForPay
# поверне покупця й надішле статус оплати.
SITE_URL=https://purrfect.com.ua

# --- Telegram: куди приходять замовлення ---
# Токен: створіть бота в @BotFather.
# CHAT_ID: напишіть боту повідомлення, тоді відкрийте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates і візьміть result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WayForPay: кабінет → Реквізити мерчанта ---
# MERCHANT_ACCOUNT — рядок «Merchant login», напр. purrfect_com_ua
# SECRET_KEY       — рядок «Merchant secret key», ним підписуються платежі.
# «Merchant password» — це НЕ те саме, у коді він не потрібен.
# Домен у кабінеті має збігатися з доменом із SITE_URL, інакше платіж
# відхилять ще до введення картки.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=

# --- Нова Пошта: кабінет → Налаштування → Безпека → Ключі API ---
# Для підказок у формі НЕ потрібен: довідник адрес Нової Пошти відкритий,
# і сайт звертається до нього напряму. Ключ знадобиться лише тоді, коли
# захочете створювати накладні прямо з сайту.
NOVAPOSHTA_API_KEY=
